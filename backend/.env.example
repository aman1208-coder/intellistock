DATABASE_URL=postgresql://postgres:replace-with-a-local-postgres-password@localhost:5432/intellistock
SECRET_KEY=replace-this-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set this before the first startup to create admin/admin@intellistock.com.
INITIAL_ADMIN_PASSWORD=replace-with-a-local-admin-password
# Used by docker compose; keep this local and do not commit real credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_DB=intellistock
OBSERVABILITY_ENABLED=true
OBSERVABILITY_INGEST_SECRET=replace-with-a-long-random-ingest-secret
SLOW_QUERY_MS=200
NETWORK_ALLOWLIST=8000,5432,5173,8080
SENSITIVE_PATHS=/.env,/etc/passwd,/etc/shadow,/root/.ssh,/.ssh,backend/intellistock.db
EBPF_COLLECTOR_ENABLED=false
CHATBOT_CONFIDENCE_THRESHOLD=0.45
CHATBOT_LLM_ENABLED=false
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
