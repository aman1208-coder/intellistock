DATABASE_URL=postgresql://postgres:postgres@localhost:5432/intellistock
SECRET_KEY=replace-this-with-a-strong-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Set this before the first startup to create admin/admin@intellistock.com.
INITIAL_ADMIN_PASSWORD=replace-with-a-local-admin-password
# Used by docker compose; keep this local and do not commit real credentials.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_DB=intellistock